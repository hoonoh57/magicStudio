# magicStudio local user content / private project data
# 사용자 시나리오, 원고, 이미지, 동영상, 음성, 렌더 결과물은 서버에 올리지 않는다.
local_projects/
user_projects/
story_archive/

# Local reusable production asset libraries
# 동작, 포즈, 스프라이트, 캐릭터 참조, 장면 참조, 제작 워크스페이스는 로컬 전용 자산으로 관리한다.
asset_library/
assets_private/
private_assets/
motion_library/
action_library/
sprite_library/
pose_library/
reference_library/
